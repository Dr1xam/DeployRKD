# Frontend (Node / React / Vite)
# ==========================================
node_modules/
dist/
build/
.next/
out/
.cache/
!**/src/main/**/build/
!**/src/test/**/build/

# Logs & Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

