# ==========================================
# Backend (Java / Spring Boot / Maven)
# ==========================================
target/
*.class
*.jar
*.war
*.ear
*.log
hs_err_pid*
replay_pid*
HELP.md

# Maven Wrapper rule (placed after *.jar so it's not ignored)
!**/.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

