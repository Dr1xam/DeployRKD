# Ports mapping (OFFSET = index * 10)
WEB_PORT=8080
API_PORT=5000

# Database Settings (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_NAME=drachenko_app
DB_USERNAME=drachenko_user
DB_PASSWORD=your_secure_password

# Spring Mail SMTP Settings
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_smtp_username
SPRING_MAIL_PASSWORD=your_smtp_password
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# Sales Reports Settings
APP_REPORTS_DEFAULT_EMAILS=recipient1@example.com
